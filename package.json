{
  "name": "playwright-automation-exercise",
  "version": "1.0.0",
  "description": "End-to-end Playwright test suite for automationexercise.com using POM, fixtures, and Allure reporting",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:webkit": "npx playwright test --project=webkit",
    "test:auth": "npx playwright test authentication.spec.ts",
    "test:communications": "npx playwright test communications.spec.ts",
    "test:catalog": "npx playwright test product-catalog.spec.ts",
    "test:search": "npx playwright test product-search.spec.ts",
    "test:orders": "npx playwright test Full-order-cycle.spec.ts",
    "test:scroll": "npx playwright test scroll-tests.spec.ts",
    "test:report": "npx playwright show-report",
    "test:ui": "npx playwright test --ui",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "typecheck": "tsc -p ."
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "automation",
    "pom",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "typescript": "^7.0.2"
  }
}
